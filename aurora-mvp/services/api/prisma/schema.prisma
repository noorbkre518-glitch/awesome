// Aurora base-slice schema. Social basics only — NO payments/coins/live here.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(USER)
  // Age gate: store confirmed adult status + DOB; app enforces 18+.
  dateOfBirth   DateTime
  isAdult       Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  // Account suspension (moderation). Suspended users are rejected by the auth guard.
  isSuspended   Boolean   @default(false)
  suspendedAt   DateTime?
  // Session/token invalidation counter. Bumped on logout and account deletion; any
  // access token carrying a stale `tv` claim is rejected immediately by the guard.
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile         Profile?
  blocksMade      Block[]   @relation("blocker")
  blocksReceived  Block[]   @relation("blocked")
  reportsMade     Report[]  @relation("reporter")
  reportsReceived Report[]  @relation("reported")
  likesFrom       Like[]    @relation("likesFrom")
  likesTo         Like[]    @relation("likesTo")
  matchesA        Match[]   @relation("matchA")
  matchesB        Match[]   @relation("matchB")
  messagesSent    Message[] @relation("messagesSent")

  @@index([isDeleted])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String   @default("")
  country     String   @default("")
  languages   String   @default("") // comma-separated ISO codes (base slice)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Block {
  id         String   @id @default(uuid())
  blockerId  String
  blockedId  String
  blocker    User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reportedId  String
  reporter    User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported    User         @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason      String
  details     String       @default("")
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

enum LikeKind {
  LIKE
  SUPER_LIKE
}

model Like {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  from      User     @relation("likesFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("likesTo", fields: [toId], references: [id], onDelete: Cascade)
  kind      LikeKind @default(LIKE)
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@index([toId])
}

model Match {
  id        String    @id @default(uuid())
  userAId   String
  userBId   String
  userA     User      @relation("matchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("matchB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("messagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
}
