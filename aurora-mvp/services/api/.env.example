# Aurora API — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real .env (it is gitignored). No real secrets belong here.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://aurora:aurora@localhost:5432/aurora?schema=public"

# Secret used to sign JWT access tokens. Use a long, random value.
# In production (NODE_ENV=production) the app refuses to start if this is unset
# or left at a placeholder value.
JWT_SECRET="change-me-in-production"

# HTTP port the API listens on.
PORT=3000

# Runtime environment: development | test | production.
NODE_ENV=development

# CORS allow-list for browser clients (native mobile apps are unaffected).
#   unset            -> reflect request origin (handy for local dev)
#   "*"              -> allow any origin
#   "https://a.com,https://b.com" -> allow only these (recommended for prod)
# CORS_ORIGIN=
